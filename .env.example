# ESPN league access (private league uses the espn_s2 and SWID cookies from a logged-in ESPN session)
ESPN_LEAGUE_ID=
ESPN_SEASON=2027
ESPN_S2=
ESPN_SWID=
# Optional: Dylan's ESPN team ID. Left blank, the app finds his team from ESPN_SWID.
ESPN_TEAM_ID=
# Backup only: ESPN usually blocks scripted logins, so the cookies above do the work.
ESPN_USERNAME=
ESPN_PASSWORD=

# Basketball Monster (Dylan's account)
BBM_USERNAME=
BBM_PASSWORD=

# Site login (single shared password) and the secret that signs the login cookie
SITE_PASSWORD=
AUTH_SECRET=

# Vercel Cron sends this as a bearer token to /api/sync
CRON_SECRET=

# Cache store. Leave blank locally (uses .data/cache.json); on Vercel, add Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
